# Base URL of the Vehicle Service API.
# This matches the `baseUrl` variable from the Postman environment.
VEHICLE_SERVICE_BASE_URL=http://localhost:4501

# Optional API key. The SDK sends it in the `X-API-Key` header.
# Leave empty if the service does not require authentication.
VEHICLE_SERVICE_API_KEY=

# Optional request timeout in seconds.
VEHICLE_SERVICE_TIMEOUT=30
